# ====================================================================
# San Roque National High School — Supabase Environment Configuration
# ====================================================================

# 1. Project URL (Find in Supabase Dashboard -> Project Settings -> API)
VITE_SUPABASE_URL=https://your-project-id.supabase.co

# 2. Public Anon API Key (Find in Supabase Dashboard -> Project Settings -> API)
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# 3. Browser-playable turnstile streams (HLS or another URL supported by the browser)
# RTSP URLs cannot be used directly by the browser; configure the gateway output URL here.
VITE_TURNSTILE_CAM_01_STREAM_URL=
VITE_TURNSTILE_CAM_02_STREAM_URL=
VITE_TURNSTILE_CAM_03_STREAM_URL=

# 4. MediaMTX WebRTC WHEP endpoints
# With the supplied infra/mediamtx.yml, use http://localhost:8889/cam-01/whep, etc.
VITE_TURNSTILE_CAM_01_WHEP_URL=http://localhost:8889/cam-01/whep
VITE_TURNSTILE_CAM_02_WHEP_URL=http://localhost:8889/cam-02/whep
VITE_TURNSTILE_CAM_03_WHEP_URL=http://localhost:8889/cam-03/whep

# 5. Local laptop/USB webcam test mode (used only when no remote stream is configured)
VITE_TURNSTILE_USE_WEBCAM=false

# 6. Recognition direction per camera. Use separate entry/exit cameras; do not alternate automatically.
VITE_TURNSTILE_CAM_01_EVENT_TYPE=entry
VITE_TURNSTILE_CAM_02_EVENT_TYPE=entry
VITE_TURNSTILE_CAM_03_EVENT_TYPE=entry

# 7. Live face descriptor path (leave both off until gallery validation; keypoint flag takes precedence)
VITE_FACE_KEYPOINT_ALIGNMENT=false
VITE_FACE_LANDMARK_ALIGNMENT=false
VITE_FACE_FAST_CONFIRM=false
# Lenient live quality gating; set false to disable quality-based descriptor filtering.
VITE_FACE_QUALITY_GATE=true

# 8. Face startup and mobile performance experiments (all disabled by default)
VITE_FACE_STARTUP_OPTIMIZATIONS=false
VITE_FACE_MOBILE_OPTIMIZATIONS=false
VITE_FACE_SELF_HOSTED_MODELS=false
VITE_FACE_DIAGNOSTICS=false
VITE_FACE_ONNX_WASM_THREADS=false
# Mobile-only experiment; leave blank for the current 640 input.
VITE_FACE_SCRFD_INPUT_SIZE=
# Set both diagnostics flags true in .env.local for dev-only crop retry telemetry.
# Keep adaptive retry OFF until paired crop distances and live performance are reviewed.
VITE_FACE_CROP_RETRY_DIAGNOSTICS=false
VITE_FACE_CROP_PADDING_COMPARISON=false
# Tries each track's last successful step first and limits that scan to two detector passes.
VITE_FACE_CROP_ADAPTIVE_RETRY=false
# Current crop detector input is 416; try 512 or 608 with diagnostics enabled.
VITE_FACE_CROP_DETECTOR_INPUT_SIZE=416
# Opt-in snapshot-aligned extraction, bounded retries, and best-frame selection.
VITE_FACE_MOTION_OPTIMIZATIONS=false
# Registration-only pose/quality checks. Set false to disable pose, lighting,
# sharpness, face-size, and detector-score gates; three descriptors stay required.
VITE_FACE_REGISTRATION_POSE_CHECK=true

# 9. Self-Hosted Android SMS Gateway Configuration (Local Network SIM Dispatch)
# Runs on-premise on an Android phone on the same LAN as edge_engine (or via port forward/tunnel)
SMS_GATEWAY_URL=http://192.168.1.50:8080
SMS_GATEWAY_USER=admin
SMS_GATEWAY_PASSWORD=
