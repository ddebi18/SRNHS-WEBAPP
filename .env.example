# ====================================================================
# San Roque National High School — Supabase Environment Configuration
# ====================================================================

# 1. Project URL (Find in Supabase Dashboard -> Project Settings -> API)
VITE_SUPABASE_URL=https://your-project-id.supabase.co

# 2. Public Anon API Key (Find in Supabase Dashboard -> Project Settings -> API)
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# 3. Browser-playable turnstile streams (HLS or another URL supported by the browser)
# RTSP URLs cannot be used directly by the browser; configure the gateway output URL here.
VITE_TURNSTILE_CAM_01_STREAM_URL=
VITE_TURNSTILE_CAM_02_STREAM_URL=
VITE_TURNSTILE_CAM_03_STREAM_URL=

# 4. MediaMTX WebRTC WHEP endpoints
# With the supplied infra/mediamtx.yml, use http://localhost:8889/cam-01/whep, etc.
VITE_TURNSTILE_CAM_01_WHEP_URL=http://localhost:8889/cam-01/whep
VITE_TURNSTILE_CAM_02_WHEP_URL=http://localhost:8889/cam-02/whep
VITE_TURNSTILE_CAM_03_WHEP_URL=http://localhost:8889/cam-03/whep

# 5. Local laptop/USB webcam test mode (used only when no remote stream is configured)
VITE_TURNSTILE_USE_WEBCAM=false

# 6. Recognition direction per camera. Use separate entry/exit cameras; do not alternate automatically.
VITE_TURNSTILE_CAM_01_EVENT_TYPE=entry
VITE_TURNSTILE_CAM_02_EVENT_TYPE=entry
VITE_TURNSTILE_CAM_03_EVENT_TYPE=entry

# 7. PhilSMS Gateway API Configuration (Philippine Cellular SMS Dispatch)
# Obtain your API token from https://app.philsms.com/
VITE_PHILSMS_API_TOKEN=
VITE_PHILSMS_SENDER_ID=PhilSMS
VITE_PHILSMS_ENDPOINT=https://app.philsms.com/api/v3/sms/send

# 8. Android SMS Gateway Options (Free SMS using your own Android phone + SIM)
#
# Option A: TextBee (RECOMMENDED — Fastest & Easiest)
#   1. Go to https://textbee.dev and click "Sign in with Google"
#   2. Copy the API Key shown right on your dashboard
#   3. Download the TextBee Android app & scan the QR code on the screen
#   VITE_TEXTBEE_API_KEY=your_textbee_api_key
#   VITE_TEXTBEE_DEVICE_ID=optional_device_id
#
# Option B: InfiniReach (https://infinireach.io)
#   VITE_INFINIREACH_API_KEY=your_infinireach_api_key
#   VITE_INFINIREACH_SENDER=+639xxxxxxxxx
#
# Option C: Capcom6 SMS Gateway for Android (local / cloud relay)
#   VITE_ANDROID_GATEWAY_URL=https://api.sms-gate.app
#   VITE_ANDROID_GATEWAY_USER=admin
#   VITE_ANDROID_GATEWAY_PASS=your_password
VITE_TEXTBEE_API_KEY=
VITE_TEXTBEE_DEVICE_ID=
VITE_INFINIREACH_API_KEY=
VITE_INFINIREACH_SENDER=
VITE_ANDROID_GATEWAY_URL=
VITE_ANDROID_GATEWAY_USER=admin
VITE_ANDROID_GATEWAY_PASS=
