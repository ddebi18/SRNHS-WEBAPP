# SMSGate Test Environment Configuration
# Copy this file to .env and populate with your test device credentials

# SMSGate API Base URL (default is official cloud gateway, or your private server)
SMSGATE_BASE_URL=https://api.sms-gate.app/3rdparty/v1

# SMSGate HTTP Basic Auth Credentials
SMSGATE_USERNAME=your_username_here
SMSGATE_PASSWORD=your_password_here

# Optional: Specific device ID if your SMSGate account manages multiple phones
# SMSGATE_DEVICE_ID=

# Optional: Specific SIM slot index on phone (1 or 2, default is OS default)
SMSGATE_SIM_NUMBER=2

# Allowlist: Comma-separated list of test phone numbers allowed to receive SMS
TEST_RECIPIENTS=+639170000001,+639180000002
