# Supabase Edge Function secrets — notify-test-sms
# Set with: supabase secrets set KEY=value
# Or in Supabase dashboard → Project Settings → Edge Functions → Secrets

# ── Feature flag (set to "true" to activate) ──────────────────────────────────
SMS_TEST_HOOK_ENABLED=false

# ── SMSGate credentials (Android phone running SMSGate app) ──────────────────
SMSGATE_BASE_URL=https://api.sms-gate.app/3rdparty/v1
SMSGATE_USERNAME=your_smsgate_username
SMSGATE_PASSWORD=your_smsgate_password
SMSGATE_SIM_NUMBER=2

# ── Test recipient(s) — comma-separated E.164 numbers ────────────────────────
TEST_RECIPIENTS=+639XXXXXXXXX

# ── Webhook security — shared secret between DB webhook and function ───────────
WEBHOOK_SECRET=generate_a_random_string_here

# ── Rate limiting (optional — defaults shown) ─────────────────────────────────
SMS_COOLDOWN_SECONDS=600
SMS_DAILY_CAP=30

# ── Auto-provided by Supabase (do NOT set these manually) ────────────────────
# SUPABASE_URL
# SUPABASE_SERVICE_ROLE_KEY
